func (m *K8sDelegate) getContainerID(ctx context.Context, devc hdspace.Devc) string {
	pod := &corev1.Pod{}
	if err := m.Client.Get(ctx, client.ObjectKey{
		Namespace: devc.Namespace,
		Name:      devc.Name,
	}, pod); err != nil {
		return ""
	}

	if len(pod.Status.ContainerStatuses) == 0 {
		return ""
	}

	return pod.Status.ContainerStatuses[0].ContainerID
}


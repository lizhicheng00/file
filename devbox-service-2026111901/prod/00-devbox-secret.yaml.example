# 使用前另存为 .yaml，填写目标命名空间和生产值。
# MYSQL_PASSWORD 与启用认证时的 REDIS_PASSWORD 填应用可解密的密文。
# Redis 无认证时，将 REDIS_PASSWORD 设为空字符串。
# OMEGA、WORK_KEY 与 beta 必须是匹配的一套材料。beta 填文件内容。
apiVersion: v1
kind: Secret
metadata:
  name: devbox-secret
  namespace: replace-prod-namespace
type: Opaque
stringData:
  MYSQL_PASSWORD: "REPLACE_PROD_MYSQL_PASSWORD_CIPHERTEXT"
  REDIS_PASSWORD: "REPLACE_PROD_REDIS_PASSWORD_CIPHERTEXT"
  OMEGA: "REPLACE_PROD_OMEGA"
  WORK_KEY: "REPLACE_PROD_WORK_KEY"
  beta: "REPLACE_PROD_BETA"

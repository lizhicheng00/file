# Run with a private "mgmt-local" HTTP Client environment.
# Keep the proxy token and client certificate paths in an untracked
# http-client.private.env.json. Example:
# {
#   "mgmt-local": {
#     "proxyToken": "<IDENTITY_PROXY_TOKEN>",
#     "SSLConfiguration": {
#       "clientCertificate": "<client.crt>",
#       "clientCertificateKey": "<client.key>",
#       "verifyHostCertificate": false
#     }
#   }
# }

@baseUrl = https://localhost:8443
@apiBase = {{baseUrl}}/open-api-inner/v1/mgmt-service
@domainId = domain-local-001
@userId = user-local-001

### 00 OpenAPI YAML
GET {{baseUrl}}/openapi.yaml

> {%
client.test("OpenAPI is available", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
});
%}

### 01 Provision or retrieve the default DevBridge API key
POST {{apiBase}}/api-key
X-DevBridge-Proxy-Token: {{proxyToken}}
X-Domain-Id: {{domainId}}
X-User-Id: {{userId}}
Content-Type: application/json

{
  "type": "devbridge"
}

> {%
client.test("Default API key is returned", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.apiKey, "Missing apiKey");
    client.assert(response.body.namespace, "Missing namespace");
    client.assert(response.body.type === "devbridge", "Unexpected key type");
});
client.global.set("defaultApiKey", response.body.apiKey);
%}

### 02 Provision or retrieve the default DevBox API key
POST {{apiBase}}/api-key
X-DevBridge-Proxy-Token: {{proxyToken}}
X-Domain-Id: {{domainId}}
X-User-Id: {{userId}}
Content-Type: application/json

{
  "type": "devbox"
}

> {%
client.test("A separate default key is returned for DevBox", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.type === "devbox", "Unexpected key type");
    client.assert(response.body.apiKey.startsWith("devbox_"), "Unexpected API key prefix");
});
client.global.set("defaultDevBoxApiKey", response.body.apiKey);
%}

### 03 Validate the API key and resolve its identity
GET {{apiBase}}/me
X-API-Key: {{defaultApiKey}}

> {%
client.test("API key resolves the current user", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.domainId === "domain-local-001", "Unexpected domainId");
    client.assert(response.body.userId === "user-local-001", "Unexpected userId");
});
%}

### 04 List API keys
GET {{apiBase}}/api-keys
X-API-Key: {{defaultApiKey}}

> {%
client.test("Default API key is listed", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(Array.isArray(response.body), "Expected an array");
    client.assert(response.body.filter(key => key.isDefault).length === 2, "Expected one default key per type");
    client.assert(response.body.some(key => key.lastUsedAt), "Missing last-used time");
});
%}

### 05 Create an additional DevBox API key
POST {{apiBase}}/api-keys
X-API-Key: {{defaultApiKey}}
Content-Type: application/json

{
  "name": "goland-{{$timestamp}}",
  "type": "devbox"
}

> {%
client.test("Additional API key is created", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.id, "Missing key id");
    client.assert(response.body.apiKey.startsWith("devbox_"), "Unexpected API key type");
});
client.global.set("createdKeyId", response.body.id);
client.global.set("createdApiKey", response.body.apiKey);
%}

### 06 Authenticate with the additional API key
GET {{apiBase}}/me
X-API-Key: {{createdApiKey}}

> {%
client.test("Additional API key resolves the current user", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
});
%}

### 07 Delete the additional API key
DELETE {{apiBase}}/api-keys/{{createdKeyId}}
X-API-Key: {{defaultApiKey}}

> {%
client.test("Additional API key is deleted", function () {
    client.assert(response.status === 204, "Expected HTTP 204");
});
%}
